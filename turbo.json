{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".agents/contracts/dependencies.json",
    ".prettierrc.json",
    "eslint-dependency-seam-allowlist.json",
    "eslint-local-rules/**",
    "eslint-style-positioning-allowlist.json",
    "eslint.config.mjs",
    "eslint.rules.mjs",
    "scripts/dependency-seams.detect.mjs",
    "scripts/eslint-config.detect.mjs",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format:check": {},
    "//#format:check": {
      "cache": false
    },
    "@app/web#typecheck": {
      "dependsOn": ["@app/web#build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false,
      "passThroughEnv": ["VITEST_SEQUENCE_SEED"]
    }
  }
}
