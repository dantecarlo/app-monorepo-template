{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["supabase"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "eslint.rules.mjs",
        "eslint-local-rules/**/*.mjs",
        ".claude/skills/**/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs",
        "eslint-local-rules/**/*.mjs",
        ".claude/skills/**/*.mjs"
      ],
      "ignoreDependencies": ["vite"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/route.ts",
        "src/components/**/{index,index}.ts",
        "src/lib/bot-protection/index.ts",
        "src/lib/image-delivery/imageCacheHeaders.helper.ts",
        "src/lib/image-delivery/imageDelivery.adapter.ts",
        "src/lib/observability/index.ts",
        "src/lib/origin-guard/index.ts",
        "src/screens/**/{index,index}.ts",
        "src/screens/*/models/*.type.ts",
        "src/services/**/{index,index}.ts",
        "src/stores/*.store.ts",
        "src/helpers/*.style.ts",
        "src/validation/*.schema.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@supabase/ssr", "@supabase/supabase-js"]
    },
    "apps/mobile": {
      "entry": [
        "src/app/**/*.tsx",
        "src/lib/i18n/i18n.config.ts",
        "src/lib/theme/theme.config.ts",
        "src/lib/observability/index.ts",
        "src/test/mocks/*.ts",
        "src/components/**/{index,index}.ts",
        "src/screens/**/{index,index}.ts",
        "src/screens/*/models/*.type.ts",
        "src/services/**/{index,index}.ts",
        "src/hooks/*.hook.ts",
        "src/helpers/*.style.ts",
        "src/validation/*.schema.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "metro": false,
      "ignoreDependencies": ["@supabase/supabase-js", "expo-system-ui"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/i18n": {
      "project": ["src/**/*.ts"]
    },
    "packages/supabase": {
      "project": ["src/**/*.ts"]
    },
    "packages/tokens": {
      "project": ["src/**/*.ts"]
    },
    "packages/cloudflare": {
      "project": ["src/**/*.ts"]
    },
    "packages/tooling": {
      "entry": ["src/*.mjs"],
      "project": ["src/**/*.mjs"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off",
    "files": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "binaries": "error",
    "unlisted": "error"
  }
}
