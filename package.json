    "tests:into-blocks": "node scripts/move-tests-into-blocks.mjs",
    "tests:into-blocks:test": "node --test scripts/move-tests-into-blocks.test.mjs",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm agent-harness:projection-check && pnpm agent-harness:test && pnpm write-guard:test && pnpm verify:agent-context:test && pnpm verify:agent-context && pnpm verify:manifest && pnpm verify:manifest:coverage && pnpm verify:manifest:test && pnpm validate:test && pnpm verify:lint-rules:test && pnpm verify:allowlist-freshness:test && pnpm verify:allowlist-freshness && pnpm verify:dependency-seams:test && pnpm verify:dependency-seams && turbo run lint typecheck test build format:check && pnpm verify:tests:test && pnpm verify:tests && pnpm tests:into-blocks:test && pnpm verify:specs:test && pnpm verify:specs && pnpm git-free-env:test && pnpm hook-git-dir:test && pnpm worktrees:prune:test && pnpm report:spec-drift:test && pnpm report:spec-drift && pnpm verify:english:test && pnpm verify:english && pnpm verify:instruction-entry:test && pnpm verify:instruction-entry && pnpm verify:unicode-safety:test && pnpm verify:unicode-safety && pnpm verify:workflow-pins:test && pnpm verify:workflow-pins && pnpm verify:skill-frontmatter:test && pnpm verify:skill-frontmatter && pnpm verify:router-coverage:test && pnpm verify:router-coverage && pnpm codex-budget:test && pnpm verify:maps && pnpm check:identity && pnpm init-project:test && pnpm verify:pairing && pnpm verify:structure && pnpm verify:security && pnpm verify:theme-sync:test && pnpm verify:theme-sync && pnpm mcp:docs:test && pnpm verify:mcp-docs:test && pnpm verify:mcp-docs && pnpm verify:ticket-branch:test && pnpm verify:skills:test && pnpm docs:diagrams:check && pnpm --filter @app/i18n test && pnpm knip",
    "validate:test": "node --test scripts/validate.test.mjs",
    "verify:agent-context": "node scripts/verify-agent-context.mjs",
    "verify:agent-context:test": "node --test scripts/verify-agent-context.test.mjs",
    "verify:allowlist-freshness": "node scripts/verify-allowlist-freshness.mjs",
    "verify:allowlist-freshness:test": "node --test scripts/verify-allowlist-freshness.test.mjs",
    "verify:dependency-seams": "node scripts/verify-dependency-seams.mjs",
    "verify:dependency-seams:test": "node --test scripts/verify-dependency-seams.test.mjs",
    "verify:english": "node scripts/verify-english.mjs",
    "verify:english:test": "node --test scripts/verify-english.test.mjs",
    "verify:expo": "cd apps/mobile && npx expo-doctor && npx expo install --check",
    "verify:instruction-entry": "node scripts/verify-instruction-entry.mjs",
    "verify:instruction-entry:test": "node --test scripts/verify-instruction-entry.test.mjs",
    "verify:lint-rules:test": "node --test eslint-local-rules/index.test.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:manifest:coverage": "node scripts/verify-manifest-coverage.mjs",
    "verify:manifest:test": "node --test scripts/manifest.test.mjs",
    "verify:maps": "node scripts/verify-maps.mjs",
    "verify:mcp-docs": "node scripts/verify-mcp-docs.mjs",
    "verify:mcp-docs:test": "node --test scripts/verify-mcp-docs.test.mjs",
    "verify:pairing": "node scripts/verify-pairing.mjs",
    "verify:security": "node scripts/verify-security-static.mjs",
    "verify:specs": "node scripts/verify-specs.mjs",
    "verify:specs:test": "node --test scripts/verify-specs.test.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:tests": "node scripts/verify-tests.mjs",
    "verify:tests:test": "node --test scripts/verify-tests.test.mjs",
    "verify:theme-sync": "node scripts/verify-theme-sync.mjs",
    "verify:theme-sync:test": "node --test scripts/verify-theme-sync.test.mjs",
    "verify:ticket-branch": "node scripts/verify-ticket-branch.mjs",
    "verify:ticket-branch:test": "node --test scripts/verify-ticket-branch.test.mjs",
    "verify:unicode-safety": "node scripts/verify-unicode-safety.mjs",
    "verify:unicode-safety:test": "node --test scripts/verify-unicode-safety.test.mjs",
    "verify:workflow-pins": "node scripts/verify-workflow-pins.mjs",
    "verify:workflow-pins:test": "node --test scripts/verify-workflow-pins.test.mjs",
    "verify:skill-frontmatter": "node scripts/verify-skill-frontmatter.mjs",
    "verify:skill-frontmatter:test": "node --test scripts/verify-skill-frontmatter.test.mjs",
    "verify:router-coverage": "node scripts/verify-router-coverage.mjs",
    "verify:router-coverage:test": "node --test scripts/verify-router-coverage.test.mjs",
    "verify:skills:test": "node --test scripts/verify-skills.test.mjs",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "worktrees:prune:test": "node --test scripts/prune-worktrees.test.mjs"
  },
  "devDependencies": {
    "@app/tooling": "workspace:*",
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-expo": "1.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-vitest": "^0.5.4",
