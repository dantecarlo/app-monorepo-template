{
  "name": "app-monorepo-template",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "agent-harness:generate": "node scripts/agent-harness/generate.mjs",
    "agent-harness:projection-check": "node scripts/agent-harness/check.mjs",
    "archify-vendor:test": "node --test scripts/archify-vendor.test.mjs",
    "agent-harness:sync": "node scripts/agent-harness/sync.mjs",
    "agent-harness:test": "node --test scripts/agent-harness/*.test.mjs",
    "write-guard:test": "node --test scripts/agent-harness/write-guard/*.test.mjs",
    "no-force:test": "node --test scripts/agent-harness/no-force/*.test.mjs",
    "reap": "node scripts/agent-harness/reaper/reap.mjs",
    "reap:kill": "node scripts/agent-harness/reaper/reap.mjs --kill",
    "reap:test": "node --test scripts/agent-harness/reaper/*.test.mjs",
    "build": "turbo run build",
    "check:identity": "node scripts/check-identity.mjs",
    "check:identity:test": "node --test scripts/check-identity.test.mjs scripts/template-identity.test.mjs",
    "codex-budget:test": "node --test scripts/codex-budget.test.mjs",
    "dev": "turbo run dev",
    "docs:diagrams": "node scripts/build-diagrams.mjs",
    "docs:diagrams:check": "node scripts/build-diagrams.mjs --check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "git-free-env:test": "node --test scripts/git-free-env.test.mjs",
    "hook-git-dir:test": "node --test scripts/hook-git-dir.test.mjs",
    "gate:test": "node --test scripts/gate/*.test.mjs",
    "init": "node scripts/init-project.mjs",
    "init-project:test": "node --test scripts/init-project*.test.mjs",
    "prune-boundary:test": "node --test scripts/prune-boundary.*.test.mjs",
    "knip": "knip --no-progress",
    "mcp:docs": "node scripts/update-mcp-docs.mjs",
    "mcp:docs:test": "node --test scripts/update-mcp-docs.test.mjs",
    "mcp:launch:test": "node --test scripts/mcp/*.test.mjs",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "report:spec-drift": "node scripts/report-spec-drift.mjs",
    "report:spec-drift:test": "node --test scripts/report-spec-drift.test.mjs",
    "smoke:e2e": "pnpm --filter @app/web build && pnpm exec playwright install --with-deps chromium && pnpm exec playwright test",
    "smoke:mobile": "pnpm --filter @app/mobile smoke:export",
    "smoke:mobile-web": "pnpm --filter @app/mobile export:web && E2E_MOBILE_WEB=1 pnpm exec playwright test --project=mobile-web-390 --project=mobile-web-768 --project=mobile-web-1280 --project=mobile-web-1920",
    "smoke:web": "pnpm --filter @app/web build && node scripts/smoke-web-render.mjs",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:visual": "E2E_VISUAL=1 pnpm exec playwright test --project=visual",
    "test:e2e:visual:update": "E2E_VISUAL=1 pnpm exec playwright test --project=visual --update-snapshots",
    "tests:into-blocks": "node scripts/move-tests-into-blocks.mjs",
    "tests:into-blocks:test": "node --test scripts/move-tests-into-blocks.test.mjs",
    "typecheck": "turbo run typecheck",
    "updaters:run": "node scripts/updaters/run.mjs",
    "updaters:run:test": "node --test scripts/updaters/run.test.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:test": "node --test scripts/validate.test.mjs",
    "verify:agent-context": "node scripts/verify-agent-context.mjs",
    "verify:agent-context:test": "node --test scripts/verify-agent-context.test.mjs",
    "verify:harness-config": "node scripts/verify-harness-config.mjs",
    "verify:harness-config:test": "node --test scripts/verify-harness-config.test.mjs",
    "verify:allowlist-freshness": "node scripts/verify-allowlist-freshness.mjs",
    "verify:allowlist-freshness:test": "node --test scripts/verify-allowlist-freshness.test.mjs",
    "verify:dependency-seams": "node scripts/verify-dependency-seams.mjs",
    "verify:dependency-seams:test": "node --test scripts/verify-dependency-seams.test.mjs",
    "verify:english": "node scripts/verify-english.mjs",
    "verify:english:test": "node --test scripts/verify-english.test.mjs",
    "verify:expo": "cd apps/mobile && npx expo-doctor && npx expo install --check",
    "verify:instruction-entry": "node scripts/verify-instruction-entry.mjs",
    "verify:instruction-entry:test": "node --test scripts/verify-instruction-entry.test.mjs",
    "verify:lint-rules:test": "node --test eslint-local-rules/index.test.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:manifest:coverage": "node scripts/verify-manifest-coverage.mjs",
    "verify:manifest:test": "node --test scripts/manifest.test.mjs",
    "verify:maps": "node scripts/verify-maps.mjs",
    "verify:mcp-docs": "node scripts/verify-mcp-docs.mjs",
    "verify:mcp-docs:test": "node --test scripts/verify-mcp-docs.test.mjs",
    "verify:pairing": "node scripts/verify-pairing.mjs",
    "verify:security": "node scripts/verify-security-static.mjs",
    "verify:specs": "node scripts/verify-specs.mjs",
    "verify:specs:test": "node --test scripts/verify-specs.test.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:tests": "node scripts/verify-tests.mjs",
    "verify:tests:test": "node --test scripts/verify-tests.test.mjs",
    "verify:theme-sync": "node scripts/verify-theme-sync.mjs",
    "verify:theme-sync:test": "node --test scripts/verify-theme-sync.test.mjs",
    "verify:ticket-branch": "node scripts/verify-ticket-branch.mjs",
    "verify:ticket-branch:test": "node --test scripts/verify-ticket-branch.test.mjs",
    "verify:unicode-safety": "node scripts/verify-unicode-safety.mjs",
    "verify:unicode-safety:test": "node --test scripts/verify-unicode-safety.test.mjs",
    "verify:updaters": "node scripts/verify-updaters.mjs",
    "verify:updaters:test": "node --test scripts/verify-updaters.test.mjs",
    "verify:workflow-pins": "node scripts/verify-workflow-pins.mjs",
    "verify:workflow-pins:test": "node --test scripts/verify-workflow-pins.test.mjs",
    "verify:skill-frontmatter": "node scripts/verify-skill-frontmatter.mjs",
    "verify:skill-frontmatter:test": "node --test scripts/verify-skill-frontmatter.test.mjs",
    "verify:skill-neutrality": "node scripts/verify-skill-neutrality.mjs",
    "verify:skill-neutrality:test": "node --test scripts/verify-skill-neutrality.test.mjs",
    "verify:router-coverage": "node scripts/verify-router-coverage.mjs",
    "verify:router-coverage:test": "node --test scripts/verify-router-coverage.test.mjs",
    "verify:skills:test": "node --test scripts/verify-skills.test.mjs",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "worktrees:prune:test": "node --test scripts/prune-worktrees.test.mjs",
    "ci-windows:test": "node --test scripts/ci-windows.test.mjs"
  },
  "devDependencies": {
    "@app/tooling": "workspace:*",
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-expo": "1.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.20.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "serve": "^14.2.6",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.mjs": [
      "eslint --fix"
    ]
  }
}
