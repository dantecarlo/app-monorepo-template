  "capabilities": [
    {
      "id": "design-tokens",
      "title": "Design tokens and theme contract",
      "group": "foundation",
      "claims": [
        "openspec/specs/packages/tokens/spec.md",
        "packages/tokens/**"
      ],
      "onAbsent": [
        {
          "verb": "remove-workspace",
          "entry": "packages/tokens"
        },
        {
          "verb": "patch-json",
          "file": "package.json",
          "op": "unset",
          "path": "scripts.verify:theme-sync"
        },
        {
          "verb": "patch-json",
          "file": "package.json",
          "op": "unset",
          "path": "scripts.verify:theme-sync:test"
        },
        {
          "verb": "remove-dep",
          "file": "apps/web/package.json",
          "name": "@app/tokens",
          "scope": "dependencies"
        },
        {
          "verb": "remove-dep",
          "file": "apps/mobile/package.json",
          "name": "@app/tokens",
          "scope": "dependencies"
        }
      ]
    },
    {
      "id": "i18n",
      "title": "Internationalization catalogs",
      "group": "foundation",
      "claims": [
        "openspec/specs/packages/i18n/spec.md",
        "packages/i18n/**"
      ],
      "onAbsent": [
        {
          "verb": "remove-workspace",
          "entry": "packages/i18n"
        },
        {
          "verb": "remove",
          "paths": [
            "apps/mobile/src/lib/i18n/**",
            "apps/web/src/i18n/**",
            "apps/web/src/lib/i18n/**"
          ]
        },
        {
          "verb": "remove-dep",
          "file": "apps/web/package.json",
          "name": "@app/i18n",
          "scope": "dependencies"
        },
        {
          "verb": "remove-dep",
          "file": "apps/mobile/package.json",
          "name": "@app/i18n",
          "scope": "dependencies"
        }
      ]
    },
    {
      "id": "web-next",
      "title": "Next.js web application",
      "group": "web",
