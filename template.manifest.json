        },
        {
          "verb": "remove-dep",
          "file": "apps/mobile/package.json",
          "name": "@sentry/react-native",
          "scope": "dependencies"
        },
        {
          "verb": "patch-json",
          "file": "apps/mobile/app.json",
          "op": "set",
          "path": "expo.plugins",
          "value": [
            "expo-router",
            [
              "expo-font",
              {
                "fonts": []
              }
            ],
            "expo-localization",
            [
              "expo-splash-screen",
