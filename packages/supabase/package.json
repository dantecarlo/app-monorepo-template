{
  "name": "@app/supabase",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.adapter.ts"
  },
  "files": [
    "src"
  ],
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push --linked",
    "gen:types": "supabase gen types typescript --linked > src/types.ts.tmp && node -e \"require('node:fs').renameSync('src/types.ts.tmp', 'src/types.ts')\" || (node --input-type=module -e \"import { removePath } from '@app/tooling/remove-path'; removePath({ path: 'src/types.ts.tmp' })\" && exit 1)",
    "test:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../../scripts/supabase-test-db.mjs"
  },
  "config": {
    "testDbTarget": "linked"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2"
  },
  "devDependencies": {
    "@app/tooling": "workspace:*",
    "typescript": "*",
    "vitest": "^4.1.9"
  }
}
