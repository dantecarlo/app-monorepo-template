# Copy this file to .env and fill in the keys of the capabilities you keep.

# region supabase
# --- Supabase: the supabase capability; its prune drops this region ---
# Required only if you wire up a real data layer: the template ships with
# mock data, so these are optional for local dev.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# endregion supabase

# ---------------------------------------------------------------------------
# Observability — PostHog is the DEFAULT adapter (swap in
# src/lib/observability/observability.adapter.ts); an optional provider's keys
# sit in its capability's region below. Keys are OPTIONAL: with no key nothing
# is constructed or sent, so the app runs fine without them.
# See docs/observability.md.
# ---------------------------------------------------------------------------

# PostHog project key. Public by design: the app sends it with every event
# and it can only write events, so EXPO_PUBLIC_ is right for it. A PostHog
# PERSONAL API key is a secret and never goes here. Absent = no PostHog
# client, nothing sent.
EXPO_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host. Absent = https://us.i.posthog.com; an EU project
# sets https://eu.i.posthog.com.
EXPO_PUBLIC_POSTHOG_HOST=

# PostHog consent mode. Absent = granted: capture from the start, with the
# SDK's ids stored on the device. opt-in = nothing captured and nothing stored
# until the consent API's grant(); memory = capture, but nothing kept on the
# device (a new anonymous id per launch). Any other value throws when the app
# starts. See docs/observability.md#consent.
EXPO_PUBLIC_POSTHOG_CONSENT=

# region sentry
# --- Sentry: the optional sentry capability; its prune drops this region ---
# Real Sentry capture requires a native dev build (not Expo Go).

# Public Sentry DSN for the mobile app. Absent = Sentry disabled.
EXPO_PUBLIC_SENTRY_DSN=

# Optional Sentry environment tag (defaults to 'development').
EXPO_PUBLIC_APP_ENV=development
# endregion sentry
